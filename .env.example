# ---------- shared ----------
APP_ENV=local
LOG_LEVEL=INFO
DB__DSN=postgresql://opstriage:opstriage@postgres:5432/opstriage
DB__AUTH_MODE=password
TELEMETRY__ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=https://<env-id>.live.dynatrace.com/api/v2/otlp
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Api-Token <token>
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=DELTA

# ---------- intake-api ----------
INTAKE__WEBHOOK_TOKENS=["dev-webhook-token"]
INTAKE__SERVICE_TOKENS=["dev-poller-token"]
INTAKE__ENABLE_DEV_ENDPOINTS=true
INTAKE__FIXTURES_DIR=/app/fixtures/dynatrace
INTAKE__MAX_PAYLOAD_BYTES=262144
# Empty locally (one DB user). Azure: id-agent-runtime. Keep comments off empty values: compose reads them as the value.
INTAKE__INBOX_CONSUMER_ROLE=

# ---------- poller ----------
POLLER__SOURCE=fake                       # grail | classic | fake
POLLER__INTERVAL_SECONDS=60
POLLER__LOOKBACK_HOURS=7                  # >= 6h Grail refresh interval + poll gap
POLLER__ACTIVE_SWEEP_EVERY_N_CYCLES=10
POLLER__INTAKE_URL=http://intake-api:8000
POLLER__INTAKE_TOKEN=dev-poller-token
POLLER__FAKE_FIXTURES_DIR=/app/fixtures/dynatrace/grail
POLLER__HTTP_TIMEOUT_SECONDS=30
POLLER__GRAIL__ENVIRONMENT_URL=https://<env-id>.apps.dynatrace.com
POLLER__GRAIL__OAUTH_CLIENT_ID=
POLLER__GRAIL__OAUTH_CLIENT_SECRET=
POLLER__GRAIL__OAUTH_SCOPES=storage:buckets:read storage:events:read storage:entities:read storage:smartscape:read
POLLER__GRAIL__SSO_URL=https://sso.dynatrace.com/sso/oauth2/token
POLLER__GRAIL__QUERY_TIMEOUT_MS=10000
POLLER__CLASSIC__ENVIRONMENT_URL=https://<env-id>.live.dynatrace.com
POLLER__CLASSIC__API_TOKEN=
POLLER__CLASSIC__PAGE_SIZE=500

# ---------- agent-runtime (triage) ----------
TRIAGE__POLICY_FILE=/app/config/policy.example.yaml   # images use /app/config/policy.yaml
TRIAGE__PUBLIC_BASE_URL=http://localhost:8010   # links to run status in notifications
TRIAGE__WORKER_CONCURRENCY=4
TRIAGE__RUN_TIMEOUT_SECONDS=600
TRIAGE__INBOX__LEASE_SECONDS=900          # must exceed RUN_TIMEOUT_SECONDS
TRIAGE__INBOX__MAX_ATTEMPTS=3
TRIAGE__INBOX__IDLE_WAIT_SECONDS=5
TRIAGE__INBOX__RETRY_BACKOFF_SECONDS=10     # failed runs wait backoff x attempt before a retry
TRIAGE__DECISION__PROVIDER=rules          # rules | systemone | llm
TRIAGE__DECISION__BASE_URL=http://kev:8009   # Azure: the Foundry resource endpoint (azurerm_cognitive_account.endpoint)
TRIAGE__DECISION__PATH=/v1/systemone      # Foundry: /providers/microsoft/v1/systemone
TRIAGE__DECISION__MODEL=kev-latest        # Foundry: the DEPLOYMENT name, not the model name
TRIAGE__DECISION__AUTH_MODE=none          # none | bearer | api_key | entra
TRIAGE__DECISION__API_KEY=
TRIAGE__DECISION__API_KEY_HEADER=api-key   # auth_mode=api_key (Azure OpenAI)
TRIAGE__DECISION__RESPONSE_FORMAT=json_schema   # llm provider: json_schema | json_object | none
TRIAGE__DECISION__EXTRA_BODY={}            # llm provider: model-specific fields, e.g. Qwen {"chat_template_kwargs":{"enable_thinking":false}}
TRIAGE__DECISION__TIMEOUT_SECONDS=10
TRIAGE__DECISION__SHUFFLE_OPTIONS=false    # option-order bias check (evals)
TRIAGE__DECISION__RUNBOOK_FILE=/app/config/triage-runbook.md   # llm provider
TRIAGE__DECISION__MAX_TOKENS=300
TRIAGE__CONTEXT__PROVIDER=fake            # grail | fake
TRIAGE__CONTEXT__FIXTURES_DIR=/app/fixtures/context   # fake provider: <display_id>.json or default.json
TRIAGE__CONTEXT__GRAIL__ENVIRONMENT_URL=https://<env-id>.apps.dynatrace.com
TRIAGE__CONTEXT__GRAIL__OAUTH_CLIENT_ID=
TRIAGE__CONTEXT__GRAIL__OAUTH_CLIENT_SECRET=
TRIAGE__CONTEXT__GRAIL__OAUTH_SCOPES=storage:buckets:read storage:events:read storage:logs:read storage:entities:read storage:smartscape:read
TRIAGE__CONTEXT__MAX_LOG_LINES=50
TRIAGE__CONTEXT__MAX_STATE_CHARS=12000
TRIAGE__SUMMARIZER__PROVIDER=template     # template | foundry
TRIAGE__SUMMARIZER__BASE_URL=https://<foundry-resource>.openai.azure.com/openai/v1/
TRIAGE__SUMMARIZER__DEPLOYMENT=gpt-main
TRIAGE__APPROVAL__MODE=auto_approve       # auto_approve (local only) | auto_reject | manual_api
TRIAGE__APPROVAL__TTL_MINUTES=30
TRIAGE__APPROVAL__SWEEP_INTERVAL_SECONDS=60   # expiry sweep and resume of decided approvals
TRIAGE__MCP__NOTIFICATION_URL=http://mcp-notification:8101/mcp
TRIAGE__MCP__TICKETING_URL=http://mcp-ticketing:8102/mcp
TRIAGE__MCP__REMEDIATION_URL=http://mcp-remediation:8103/mcp
TRIAGE__MCP__NOTIFICATION_TOKEN=dev-mcp-notification
TRIAGE__MCP__TICKETING_TOKEN=dev-mcp-ticketing
TRIAGE__MCP__REMEDIATION_TOKEN=dev-mcp-remediation
TRIAGE__MCP__TIMEOUT_SECONDS=60
TRIAGE__ADMIN_TOKENS=["dev-admin-token"]

# ---------- health-review (insights, OTA-APP-002) ----------
INSIGHTS__SOURCE=fake                     # fake | grail
INSIGHTS__FIXTURES_DIR=/app/fixtures/insights
INSIGHTS__CONFIG_FILE=/app/config/insights.example.yaml
INSIGHTS__SERVICE_TOKENS='["dev-insights-token"]'
INSIGHTS__GRAIL__ENVIRONMENT_URL=https://<env-id>.apps.dynatrace.com
INSIGHTS__GRAIL__OAUTH_CLIENT_ID=
INSIGHTS__GRAIL__OAUTH_CLIENT_SECRET=
INSIGHTS__GRAIL__OAUTH_SCOPES=storage:buckets:read storage:logs:read storage:metrics:read storage:events:read storage:entities:read storage:smartscape:read
INSIGHTS__GRAIL__SSO_URL=https://sso.dynatrace.com/sso/oauth2/token
INSIGHTS__GRAIL__QUERY_TIMEOUT_MS=10000
INSIGHTS__SCHEDULE__DAILY_AT=06:00
INSIGHTS__SCHEDULE__TIMEZONE=UTC
INSIGHTS__COLLECT__LOG_WINDOW=PT24H
INSIGHTS__COLLECT__TREND_WINDOW=P30D
INSIGHTS__COLLECT__MAX_LOG_RECORDS=50000
INSIGHTS__DIGEST__MAX_TOKENS=12000
# Analyst: any OpenAI-compatible chat model (vLLM/Qwen, Ollama, OpenAI, Azure OpenAI, gateways); see docs/model-providers.md
INSIGHTS__ANALYST__PROVIDER=llm           # llm | none (rules-only reports)
INSIGHTS__ANALYST__BASE_URL=http://host.docker.internal:18001
INSIGHTS__ANALYST__PATH=/v1/chat/completions
INSIGHTS__ANALYST__MODEL=qwen3.8-flash-next
INSIGHTS__ANALYST__AUTH_MODE=none         # none | bearer | api_key | entra
INSIGHTS__ANALYST__API_KEY=
INSIGHTS__ANALYST__API_KEY_HEADER=api-key
INSIGHTS__ANALYST__RESPONSE_FORMAT=json_schema   # json_schema | json_object | none
INSIGHTS__ANALYST__EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}   # Qwen on vLLM; {} for others
INSIGHTS__ANALYST__TEMPERATURE=0
INSIGHTS__ANALYST__MAX_TOKENS=2000
INSIGHTS__ANALYST__TIMEOUT_SECONDS=180
INSIGHTS__ANALYST__ATTEMPTS=2
INSIGHTS__ANALYST__REPAIR_ATTEMPTS=1
INSIGHTS__ANALYST__CONCURRENCY=1          # the model is shared with triage
INSIGHTS__ANALYST__RUNBOOK_FILE=/app/config/insights-runbook.md
INSIGHTS__NOTIFY__ENABLED=true
INSIGHTS__NOTIFY__MCP_URL=http://mcp-notification:8101/mcp
INSIGHTS__NOTIFY__MCP_TOKEN=dev-mcp-notification
INSIGHTS__NOTIFY__TIMEOUT_SECONDS=30
INSIGHTS__NOTIFY__MIN_RISK=low            # send the Teams card only at or above this risk
INSIGHTS__NOTIFY__TOP_FINDINGS=5
INSIGHTS__GUARD__PROVIDER=http           # http | keyword (offline fake)
INSIGHTS__GUARD__TIMEOUT_SECONDS=20
INSIGHTS__GUARD__BASE_URL=http://host.docker.internal:18004   # needs 18004:8004 in the kev-tunnel EXTRA_FORWARDS
INSIGHTS__RETENTION__REPORT_TTL=PT48H
INSIGHTS__RETENTION__EVIDENCE_MAX_AGE=PT28H
INSIGHTS__RETENTION__EVIDENCE_AFTER_REPORT=PT4H
INSIGHTS__RETENTION__PURGE_INTERVAL=PT15M
INSIGHTS__TICKETS__ENABLED=false
INSIGHTS__WEB__BASE_URL=http://localhost:8120
INSIGHTS__WEB__SESSION_SECRET=change-me-dev-only    # required (not this value) outside APP_ENV=local
INSIGHTS__WEB__SESSION_TTL=PT8H
INSIGHTS__WEB__ALLOW_DOWNLOAD=false
INSIGHTS__WEB__TRUSTED_PROXY_HEADER=
INSIGHTS__WEB__SPARKLINE_POINTS=96

# ---------- mcp-notification ----------
NOTIFICATION__TEAMS__PROVIDER=workflows_webhook   # workflows_webhook | log
NOTIFICATION__TEAMS__WEBHOOK_URL=http://webhook-sink:8090/teams
NOTIFICATION__TEAMS__CARD_VERSION=1.5
NOTIFICATION__EMAIL__PROVIDER=smtp                # smtp | acs | log
NOTIFICATION__EMAIL__FROM_ADDRESS=opstriage@local.test
NOTIFICATION__EMAIL__DEFAULT_RECIPIENTS=["oncall@local.test"]
NOTIFICATION__EMAIL__SMTP_HOST=mailpit
NOTIFICATION__EMAIL__SMTP_PORT=1025
NOTIFICATION__EMAIL__ACS_ENDPOINT=https://<acs-resource>.communication.azure.com
NOTIFICATION__RATE_LIMIT_PER_MINUTE=20

# ---------- mcp-ticketing ----------
TICKETING__PROVIDER=fake                  # fake (v1)
TICKETING__PUBLIC_BASE_URL=http://localhost:8102

# ---------- mcp-remediation ----------
REMEDIATION__ENABLED=true
REMEDIATION__DRY_RUN=true
REMEDIATION__SYNC_WAIT_SECONDS=120
REMEDIATION__CIRCUIT_BREAKER_FAILURES=3
REMEDIATION__CIRCUIT_BREAKER_WINDOW_MINUTES=30
REMEDIATION__DEFAULT_RESTART_TIMEOUT_SECONDS=30
REMEDIATION__TARGETS_FILE=/app/config/targets.example.yaml   # images use /app/config/targets.yaml
REMEDIATION__ALLOW_LOCAL_DOCKER=true
REMEDIATION__MAX_AUTONOMY=approval_required   # global ceiling: notify_only | approval_required | autonomous
REMEDIATION__APPROVAL_TTL_MINUTES=30
REMEDIATION__ALLOWED_APPROVAL_MODES=["auto_approve","manual_api"]   # Azure: ["manual_api","teams_link","teams_bot"]
REMEDIATION__AZURE__SUBSCRIPTION_ID=
REMEDIATION__SSH__USERNAME=svc-restart
REMEDIATION__SSH__PRIVATE_KEY=

# ---------- per-service values (set in compose.yaml environment:, not here) ----------
# intake-api and agent-runtime default SERVER__PORT to 8000 and 8010 in their settings classes.
# AUTH__INBOUND_TOKENS='["dev-mcp-remediation"]'   one token list per MCP server
# SERVER__PORT=8103                                 per MCP server

# ---------- docker compose host ports (interpolation only; containers still talk on internal ports) ----------
SINK_HOST_PORT=8090                       # mock Teams viewer at http://localhost:${SINK_HOST_PORT}/
# compose.kev.yaml. Containers on this Mac cannot reach the LAN (ADR 0006): run scripts/kev-tunnel.sh install and
# use the tunnel. With Docker's Local Network permission granted, http://192.168.5.147:8003 works directly.
KEV_BASE_URL=http://host.docker.internal:18003
QWEN_BASE_URL=http://host.docker.internal:18001   # compose.qwen.yaml (via scripts/kev-tunnel.sh)
