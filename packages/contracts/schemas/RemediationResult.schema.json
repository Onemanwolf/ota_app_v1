{
  "$defs": {
    "RemediationStatus": {
      "enum": [
        "in_progress",
        "dry_run",
        "restarted",
        "rejected",
        "failed"
      ],
      "title": "RemediationStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "duplicate": {
      "default": false,
      "title": "Duplicate",
      "type": "boolean"
    },
    "executor": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Executor"
    },
    "finished_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    },
    "idempotency_key": {
      "title": "Idempotency Key",
      "type": "string"
    },
    "output_tail": {
      "anyOf": [
        {
          "maxLength": 4096,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Tail"
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "status": {
      "$ref": "#/$defs/RemediationStatus"
    },
    "target_id": {
      "title": "Target Id",
      "type": "string"
    }
  },
  "required": [
    "target_id",
    "idempotency_key",
    "status"
  ],
  "title": "RemediationResult",
  "type": "object"
}
