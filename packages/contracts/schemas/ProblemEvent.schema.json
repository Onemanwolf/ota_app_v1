{
  "$defs": {
    "AlertSource": {
      "enum": [
        "dynatrace.workflow",
        "dynatrace.classic_webhook",
        "dynatrace.poller.grail",
        "dynatrace.poller.classic",
        "simulator"
      ],
      "title": "AlertSource",
      "type": "string"
    },
    "EntityRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "type": {
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "title": "EntityRef",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "description": "One piece of Davis evidence (Problems API v2 `evidenceDetails`, or Grail `dt.davis.events` joined via\n`dt.davis.event_ids`). Added in schema 1.1; see reports/Dynatrace Kafka triage data models.md.",
      "properties": {
        "display_name": {
          "title": "Display Name",
          "type": "string"
        },
        "ended_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ended At"
        },
        "entity": {
          "anyOf": [
            {
              "$ref": "#/$defs/EntityRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "event_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Id"
        },
        "event_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Type"
        },
        "evidence_type": {
          "enum": [
            "EVENT",
            "METRIC",
            "TRANSACTIONAL",
            "MAINTENANCE_WINDOW",
            "AVAILABILITY_EVIDENCE"
          ],
          "title": "Evidence Type",
          "type": "string"
        },
        "metric_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metric Id"
        },
        "root_cause_relevant": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Root Cause Relevant"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "value_after": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value After"
        },
        "value_before": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value Before"
        }
      },
      "required": [
        "evidence_type",
        "display_name"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "ProblemStatus": {
      "enum": [
        "ACTIVE",
        "CLOSED"
      ],
      "title": "ProblemStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Canonical, source-agnostic problem observation. Anti-corruption adapters produce it.",
  "properties": {
    "affected_entities": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EntityRef"
      },
      "title": "Affected Entities",
      "type": "array"
    },
    "category": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Category"
    },
    "display_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "User-facing ID such as P-2307288",
      "title": "Display Id"
    },
    "ended_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ended At"
    },
    "evidence": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "impact_levels": {
      "default": [],
      "items": {
        "enum": [
          "APPLICATION",
          "ENVIRONMENT",
          "INFRASTRUCTURE",
          "SERVICE",
          "SYNTHETIC"
        ],
        "type": "string"
      },
      "title": "Impact Levels",
      "type": "array"
    },
    "is_duplicate": {
      "default": false,
      "title": "Is Duplicate",
      "type": "boolean"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "problem_id": {
      "description": "Grail event.id, classic {PID} or Problems API v2 problemId",
      "title": "Problem Id",
      "type": "string"
    },
    "problem_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Problem Url"
    },
    "root_cause_entity": {
      "anyOf": [
        {
          "$ref": "#/$defs/EntityRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "default": "1.1",
      "enum": [
        "1.0",
        "1.1"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "severity": {
      "anyOf": [
        {
          "maximum": 5,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Grail event.severity, ITIL-aligned: 1 = Critical, 2 = High, 3 = Medium, 4 = Low, 5 = Informational. None when Dynatrace sets none; always None from Problems API v2 and the classic webhook.",
      "title": "Severity"
    },
    "source": {
      "$ref": "#/$defs/AlertSource"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ProblemStatus"
    },
    "tags": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Tags",
      "type": "object"
    },
    "title": {
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "source",
    "problem_id",
    "status",
    "title",
    "started_at",
    "observed_at"
  ],
  "title": "ProblemEvent",
  "type": "object"
}
